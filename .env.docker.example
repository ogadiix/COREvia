# ============================================================================
# COREvia Docker Deployment Environment Configuration
# Copy this file to .env before executing: docker compose up -d
# ============================================================================

NODE_ENV=production
PORT=3000
APP_PORT=3000
POSTGRES_PORT=5432

# Application Configuration
APP_URL=http://localhost:3000
SESSION_SECRET=corevia_institutional_session_secret_key_prod_2026_xyz
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# PostgreSQL Container Credentials
POSTGRES_USER=corevia
POSTGRES_PASSWORD=corevia_secure_password_2026
POSTGRES_DB=corevia_db

# Connection String used by COREvia App to reach PostgreSQL Container
DATABASE_URL=postgres://corevia:corevia_secure_password_2026@postgres:5432/corevia_db

# Google Gemini API Key (Optional — deterministic offline rule-based fallback active when omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

